{
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "search.exclude": {
        "package-lock.json": true,
        "pnpm-lock.yaml": true,
        "pnpm-workspace.yaml": true,
        "node_modules": true,
        "dist": true,
        "coverage": true
    },

    "editor.tabSize": 4,
    "eslint.useFlatConfig": true,
    "eslint.debug": true,
    "eslint.options": {
        "overrideConfigFile": "eslint.config.mjs"
    },

    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    "typescript.preferences.importModuleSpecifier": "non-relative",
    "typescript.preferences.quoteStyle": "single",

    "[typescript][json][jsonc][yaml][dockercompose][handlebars][javascript][dotenv][shellscript][dockerfile]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    "editor.bracketPairColorization.enabled": true,
    "better-comments.multilineComments": true,
    "better-comments.highlightPlainText": true,

    "prisma.pinToPrisma6": true,
    "workbench.colorCustomizations": {
        "statusBarItem.warningBackground": "#b72c1f",
        "statusBarItem.warningForeground": "#ffffff",
        "statusBarItem.warningHoverBackground": "#b72c1f",
        "statusBarItem.warningHoverForeground": "#ffffff90",
        "statusBarItem.remoteHoverBackground": "#d14639",
        "statusBarItem.remoteHoverForeground": "#ffffff90",
        "statusBar.noFolderBackground": "#b72c1f",
        "statusBar.noFolderForeground": "#ffffff",
        "statusBar.noFolderBorder": "#b72c1f",
        "statusBar.prominentBackground": "#b72c1f",
        "statusBar.prominentForeground": "#ffffff",
        "statusBar.prominentHoverBackground": "#b72c1f",
        "statusBar.prominentHoverForeground": "#ffffff90",
        "focusBorder": "#b72c1f99",
        "progressBar.background": "#b72c1f",
        "textLink.foreground": "#f76c5f",
        "textLink.activeForeground": "#ff796c",
        "selection.background": "#aa1f12",
        "list.highlightForeground": "#b72c1f",
        "list.focusAndSelectionOutline": "#b72c1f99",
        "button.background": "#b72c1f",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#c4392c",
        "tab.activeBorderTop": "#c4392c",
        "pickerGroup.foreground": "#c4392c",
        "list.activeSelectionBackground": "#b72c1f4d",
        "panelTitle.activeBorder": "#c4392c",
        "activityBar.activeBorder": "#b72c1f",
        "statusBarItem.remoteBackground": "#c4392c",
        "statusBarItem.remoteForeground": "#ffffff",
        "statusBar.background": "#b72c1f",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#b72c1f",
        "statusBar.debuggingBackground": "#b72c1f",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.debuggingBorder": "#b72c1f",
        "activityBarBadge.foreground": "#ffffff",
        "activityBarBadge.background": "#b72c1f"
    },
    "window.title": "order-booking-backend",
    "projectColors.mainColor": "#b72c1f",
    "cSpell.words": ["fkey", "pkey"]
}

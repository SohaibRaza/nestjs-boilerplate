        "@fastify/compress": "^8.3.1",
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/multipart": "^9.4.0",
        "@fastify/static": "^9.0.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/cache-manager": "^3.1.0",
        "@nestjs/common": "^11.1.15",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.15",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-fastify": "^11.1.15",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@paralleldrive/cuid2": "^3.3.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@sentry/nestjs": "^10.42.0",
        "@sentry/profiling-node": "^10.42.0",
        "@smithy/types": "^4.13.0",
        "@supercharge/request-ip": "^1.2.0",
        "axios": "^1.13.6",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.70.2",
        "bytes": "^3.1.2",
        "cache-manager": "^7.2.8",
        "case": "^1.6.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "crypto-js": "^4.2.0",
        "dotenv": "^17.3.1",
        "fastify": "^5.8.1",
        "google-auth-library": "^10.6.1",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.0.1",
        "keyv": "^5.6.0",
        "lodash": "^4.17.23",
        "luxon": "^3.7.2",
        "mime": "^4.1.0",
        "ms": "^2.1.3",
        "nest-commander": "^3.20.1",
        "nestjs-i18n": "^10.6.0",
        "nestjs-pino": "^4.6.0",
        "nestjs-real-ip": "^3.0.1",
        "otplib": "^13.3.0",
        "papaparse": "^5.5.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.20.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "strip-ansi": "^7.2.0",
        "ua-parser-js": "^2.0.9",
        "uuid": "^13.0.0",
        "verify-apple-id-token": "^3.1.2",
        "vitest": "^4.0.18"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.4.3",
        "@commitlint/config-conventional": "^20.4.3",
        "@eslint/js": "^10.0.1",
        "@golevelup/ts-jest": "^1.2.1",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.15",
        "@swc/cli": "^0.8.0",
        "@swc/core": "^1.15.18",
        "@swc/jest": "^0.2.39",
        "@types/bytes": "^3.1.5",
        "@types/crypto-js": "^4.2.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.24",
        "@types/luxon": "^3.7.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^25.3.3",
        "@types/papaparse": "^5.5.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.18.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "cspell": "^9.7.0",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.3.2",
        "prettier": "^3.8.1",
        "prisma": "^7.4.2",
        "rimraf": "^6.1.3",
        "rxjs-marbles": "^7.0.1",
        "stop-only": "^3.4.4",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "ts-prune": "^0.10.3",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint",
            "stop-only --file"
        ],
        "*.{json,yaml}": [
            "prettier --write"
        ]
    },
    "packageManager": "pnpm@10.30.3",
    "engines": {
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm",
        "node": ">= 24.11.0",
        "pnpm": ">= 10.25.0"
    },
    "resolutions": {
        "form-data": "^4.0.5",
        "glob": "^13.0.0",
        "jws": "^4.0.1",
        "@babel/helpers": "^7.26.10",
        "js-yaml": "^4.1.1",
        "brace-expansion": "^4.0.1",
        "tmp": "^0.2.4",
        "body-parser": "^2.2.1",
        "minimatch": "^10.0.0"
    }
}
